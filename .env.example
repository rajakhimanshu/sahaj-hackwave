# ===== REQUIRED (get these first) =====

# Google Gemini API key
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override model (default: Gemini 3.5, with 2.5 and 3.8 fallbacks)
# GEMINI_MODEL=gemini-3.5-flash

# Vercel only: proxy /api/* to the AWS deployment without exposing CORS.
# Leave empty locally and on AWS so Next.js uses its own route handlers.
# AWS_API_ORIGIN=https://api.your-domain.com

# ===== AWS DEPLOY (provide when ready) =====

# AWS region (your older projects used ap-south-1)
AWS_REGION=ap-south-1

# IAM user access keys for CLI deploy (EC2 / Amplify / ECR)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Public URL after deploy (fill later)
# NEXT_PUBLIC_APP_URL=https://your-domain-or-ec2-ip
