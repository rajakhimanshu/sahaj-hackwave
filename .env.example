# ===== REQUIRED (get these first) =====

# Google Gemini API key
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override model (default: gemini-3.5-flash, 3.8 fallback)
# GEMINI_MODEL=gemini-3.5-flash

# ===== AWS DEPLOY (provide when ready) =====

# AWS region (your older projects used ap-south-1)
AWS_REGION=ap-south-1

# IAM user access keys for CLI deploy (EC2 / Amplify / ECR)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Public URL after deploy (fill later)
# NEXT_PUBLIC_APP_URL=https://your-domain-or-ec2-ip
